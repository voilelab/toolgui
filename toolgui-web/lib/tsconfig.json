{
  "compilerOptions": {
    // react-scripts used to pull ambient @types that masked the missing
    // target/lib here; spell them out now that it is gone.
    "target": "es2015",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "jsx": "react-jsx",
    "checkJs": false,
    "baseUrl": ".",
    "noEmit": false,
    "emitDeclarationOnly": true,
    "declaration": true,
    "outDir": "build",
    "rootDir": "src",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "paths": {
      "@toolgui-web/lib/src": [
        "src"
      ],
    }
  },
  "include": [
    "src",
  ],
  "exclude": [
    "node_modules/**/*",
  ]
}